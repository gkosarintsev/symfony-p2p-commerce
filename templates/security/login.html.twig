{% extends 'base.html.twig' %}

{% block title %}Sign In{% endblock %}

{% block body %}
<div style="max-width: 440px; margin: 40px auto;">
    <div class="card">
        <h1 style="font-size: 24px; font-weight: 700; margin-bottom: 8px;">Welcome Back</h1>
        <p style="color: var(--text-muted); font-size: 14px; margin-bottom: 24px;">Sign in to your wallet and marketplace account.</p>

        {% if error %}
            <div class="alert alert-error" style="margin-bottom: 20px;">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form method="post" action="{{ path('app_login') }}" id="login-form">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="form-group">
                <label for="username" class="form-label">Email Address</label>
                <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-input" autocomplete="email" required autofocus>
            </div>

            <div class="form-group">
                <label for="password" class="form-label">Password</label>
                <input type="password" name="_password" id="password" class="form-input" autocomplete="current-password" required>
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 8px;">
                Sign In
            </button>
        </form>

        <div style="margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--border);">
            <div style="font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--text-muted); margin-bottom: 12px; letter-spacing: 0.05em;">
                ⚡ Quick Demo Access (1-Click Fill)
            </div>
            <div style="display: flex; flex-direction: column; gap: 8px;">
                <button type="button" class="btn btn-outline btn-sm" style="justify-content: space-between;" onclick="fillLogin('alice@example.com', 'password123')">
                    <span>Alice (Buyer / Seller)</span>
                    <span class="badge badge-success">$1,500.00</span>
                </button>
                <button type="button" class="btn btn-outline btn-sm" style="justify-content: space-between;" onclick="fillLogin('bob@example.com', 'password123')">
                    <span>Bob (Merchant)</span>
                    <span class="badge badge-primary">$500.00</span>
                </button>
                <button type="button" class="btn btn-outline btn-sm" style="justify-content: space-between;" onclick="fillLogin('admin@example.com', 'password123')">
                    <span>Admin Liquidity</span>
                    <span class="badge badge-warning">$10,000.00</span>
                </button>
            </div>
        </div>

        <p style="text-align: center; margin-top: 20px; font-size: 14px; color: var(--text-muted);">
            Don't have an account? <a href="{{ path('app_register') }}" style="color: var(--primary); font-weight: 600; text-decoration: none;">Register now</a>
        </p>
    </div>
</div>

<script>
function fillLogin(email, pass) {
    document.getElementById('username').value = email;
    document.getElementById('password').value = pass;
    document.getElementById('login-form').submit();
}
</script>
{% endblock %}
